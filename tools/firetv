#!/usr/bin/env bash
# Set up and look after the Fire TV. Every step is both a menu entry and a
# command: firetv shows the menu, firetv STEP runs that one step. STEPS is
# the one list of them, for the menu, the commands and --help. Wraps the
# scripts beside it. Quitting the menu drops the adb connection.
set -euo pipefail
# Where the user ran this from, for APK paths they type relative to it.
START_DIR="${PWD}"
cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=ui.sh
source ./ui.sh

HOF_SERVICE="${HOF}/.HijackService"

# The steps, in menu order, as "NAME;ARGS;WHAT IT DOES". firetv NAME runs
# do_NAME; the menu lists NAME and what it does. Doctor is first, so Enter
# on the menu changes nothing.
STEPS=(
    "doctor;;check the TV, launcher, debloat and storage"
    "setup;;walk through setting up the TV, step by step"
    "install;;put the launcher on the TV, clear old builds and make it Home"
    "tune;[NAME on|off];disable Amazon's ad apps and apply speed tweaks"
    "apps;[list|add APP|remove [APP...]];get apps from the Appstore, sideload or uninstall"
    "clean;;trim app caches and remove old launcher builds"
    "reboot;;restart the TV"
    "reset;;remove the launcher and restore Amazon's home"
)

# shellcheck disable=SC2016  # the backticks are Markdown
usage() {
    local step name args what
    {
        printf '# firetv\n\nSet up and look after the Fire TV. With no command, a menu of the same steps.\n\n'
        printf '## Usage\n\n    firetv [COMMAND [ARGS]]\n\n## Commands\n\n| Command | What it does |\n|---|---|\n'
        for step in "${STEPS[@]}"; do
            IFS=';' read -r name args what <<< "${step}"
            printf '| `%s` | %s |\n' "${name}${args:+ ${args//|/\\|}}" "${what}"
        done
        printf '\n`tune` with no arguments is a checklist in a terminal and a list'
        printf ' elsewhere, and `apps` a menu in a terminal and a list elsewhere. `apps add`'
        printf ' takes a name from tools/appstore.txt, a package, an ASIN or an amazon.com link.'
        printf ' setup, install and reset need a terminal.\n\n'
        printf 'The TV is the IP that `setup` or the menu asked for, or `FIRETV_HOST`\n(IP, or IP:port) when set.\n'
    } | show_help
}

CMD="${1:-}"
case "${CMD}" in
    -h|--help|help) usage; exit 0 ;;
esac
[[ $# -eq 0 ]] || shift
if [[ -n "${CMD}" ]]; then
    found=""
    for step in "${STEPS[@]}"; do
        [[ "${step%%;*}" != "${CMD}" ]] || found="${step}"
    done
    [[ -n "${found}" ]] || die "Unknown command: ${CMD} (see firetv --help)"
    found="${found#*;}"
    [[ -n "${found%%;*}" || $# -eq 0 ]] || die "firetv ${CMD} takes no arguments (see firetv --help)"
fi

# The menu and the steps that ask need a terminal; doctor, tune, apps,
# clean and reboot run anywhere. gum draws the prompts when it is installed;
# without it they are numbered lists and plain questions.
case "${CMD}" in
    ""|setup|install|reset)
        [[ -t 0 && -t 1 ]] || die "firetv${CMD:+ ${CMD}} is interactive; run it in a terminal"
        ;;
esac
command -v adb >/dev/null 2>&1 || die "adb not found: run tools/setup.sh, or brew install --cask android-platform-tools"

# Runs one menu action in a subshell, so die and the TV lock end with the
# action and the menu carries on. Not "( ... ) || warn": bash ignores set -e
# inside an || list.
run() {
    local rc
    set +e
    ( set -e; "$@" )
    rc=$?
    set -e
    (( rc == 0 )) || log_warn "Stopped (exit ${rc})"
}

# Doctor exits 1 when a check failed. Its summary already says so, so only
# firetv doctor passes that on, not the menu or the walkthrough.
do_doctor() {
    local rc=0
    ./doctor.sh || rc=$?
    [[ "${CMD}" != doctor ]] || return "${rc}"
}


# versionName of an installed package, or empty.
version() {
    tv shell dumpsys package "$1" | tr -d '\r' | sed -n 's/^ *versionName=//p' | head -1
}

# The latest release's version (0.3), or nothing when GitHub cannot be
# reached. gh reaches a private repo; once it is public, the latest-release
# page's redirect names the tag.
latest_version() {
    local tag=""
    if command -v gh >/dev/null 2>&1; then
        tag="$(gh release view --repo "${REPO}" --json tagName --jq .tagName 2>/dev/null || true)"
    fi
    if [[ -z "${tag}" ]]; then
        tag="$(curl -fsSI --max-time 5 "https://github.com/${REPO}/releases/latest" 2>/dev/null \
            | tr -d '\r' | sed -n 's|^[Ll]ocation: .*/releases/tag/||p' | head -1 || true)"
    fi
    printf '%s\n' "${tag#v}"
}

# True when version $1 is older than $2 (0.9 is older than 0.10).
older() {
    [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" == "$1" ]]
}

# Reads the TV's launcher against the latest release: INSTALLED (empty when
# not installed), LATEST (empty when GitHub cannot be reached), and OLD_KEY,
# true when it was signed with a key other than the release key.
read_launcher() {
    INSTALLED="$(version "${LAUNCHER_PKG}")"
    LATEST="$(latest_version)"
    OLD_KEY=false
    if [[ -n "${INSTALLED}" && ",$(launcher_signature)," != *",${LAUNCHER_SIGNATURE},"* ]]; then
        OLD_KEY=true
    fi
}

# Says what replacing an old-key launcher costs, then asks before installing
# over the TV's launcher, naming the versions.
confirm_install() {
    [[ "${OLD_KEY}" == false ]] \
        || log_warn "The TV's launcher is signed with an old key, so installing replaces it: its favorites, hidden apps and theme are cleared."
    if [[ -n "${LATEST}" ]] && older "${INSTALLED}" "${LATEST}"; then
        confirm "Update the launcher from ${INSTALLED} to ${LATEST}?"
    elif [[ "${INSTALLED}" == "${LATEST}" ]]; then
        confirm "The launcher ${INSTALLED} is installed, the latest. Reinstall it?"
    else
        confirm "The launcher ${INSTALLED} is installed. Reinstall or update it?"
    fi
}

# On opening the menu: says when a newer release is out and offers to
# install it. Quiet when the TV or GitHub cannot be reached or the launcher
# is not installed; the menu works without them.
offer_update() {
    adb_connect >/dev/null
    [[ "$(tv get-state 2>/dev/null)" == device ]] || return 0
    read_launcher
    if [[ -z "${INSTALLED}" || -z "${LATEST}" ]] || ! older "${INSTALLED}" "${LATEST}"; then
        return 0
    fi
    if [[ "${OLD_KEY}" == true ]]; then
        _box "Launcher ${LATEST} is out; the TV has ${INSTALLED}.
The TV's launcher is signed with an old key, so updating replaces it:
its favorites, hidden apps and theme are cleared."
    else
        _box "Launcher ${LATEST} is out; the TV has ${INSTALLED}."
    fi
    confirm "Install ${LATEST} now?" || return 0
    run do_install --confirmed
    printf '\n'
}

# True when this computer can build the launcher: setup.sh --build pointed
# the build at an Android SDK, or ANDROID_HOME names one.
can_build() {
    grep -q '^sdk\.dir=' ../local.properties 2>/dev/null || [[ -n "${ANDROID_HOME:-}" ]]
}

# Downloads the latest release; on a computer that can build, building here
# is offered too. --confirmed is offer_update's: the user agreed to that
# release, so it downloads it without asking again. Whenever the launcher
# ends up on the TV, even when not reinstalled, it is then made Home.
do_install() {
    local how=Download confirmed=false
    local -a replace=()
    [[ "${1:-}" != --confirmed ]] || confirmed=true
    connect
    read_launcher
    if [[ -n "${INSTALLED}" && "${confirmed}" == false ]] && ! confirm_install; then
        make_home
        return
    fi
    # The user has agreed to the replacing; install_launcher need not ask.
    [[ "${OLD_KEY}" == false ]] || replace=(--replace)
    if [[ "${confirmed}" == false ]] && can_build; then
        how="$(choose_one "Install the launcher" "" "Download the latest release" "Build it here (tools/install.sh)")"
        if [[ -z "${how}" ]]; then
            [[ -z "${INSTALLED}" ]] || make_home
            return 0
        fi
    fi
    if [[ "${how}" == Build* ]]; then
        ./install.sh --launch
        # A failed uninstall is already reported; Home setup still runs.
        remove_old_builds || true
        make_home
        return
    fi
    # Not local: the EXIT trap runs after this function has returned.
    tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp}"; unlock' EXIT
    # gh reaches the release while the repo is private; curl once it is public.
    # One spinner for both, so a failed gh is not reported when curl works.
    # shellcheck disable=SC2016  # $1 and $2 expand in the inner sh
    spin "Downloading launcher.apk" sh -c '
        { command -v gh >/dev/null 2>&1 && gh release download --repo "$1" --pattern launcher.apk --dir "$2"; } \
            || curl -fsSL -o "$2/launcher.apk" "https://github.com/$1/releases/latest/download/launcher.apk"' _ "${REPO}" "${tmp}" \
        || die "Could not download launcher.apk from https://github.com/${REPO}/releases/latest. While the repo is private, run tools/setup.sh to sign in to GitHub."
    install_launcher ${replace[@]+"${replace[@]}"} "${tmp}/launcher.apk"
    tv shell am start -n "${LAUNCHER_PKG}/.MainActivity" >/dev/null
    _success "Installed the launcher and opened it on the TV."
    remove_old_builds || true
    make_home
}

# Package the Home intent resolves to; android's resolver when no default.
home_package() {
    tv shell cmd package resolve-activity -a android.intent.action.MAIN -c android.intent.category.HOME \
        | tr -d '\r' | sed -n 's/^ *packageName=//p' | head -1
}

# Makes the installed launcher the Home app, after do_install has connected.
make_home() {
    if [[ "$(home_package)" == "${LAUNCHER_PKG}" ]]; then
        _success "The launcher is already the Home app."
        return 0
    fi
    # Fire OS 8.1.6.9 and later: Home stays Amazon's, Home on Fire opens the launcher.
    if [[ "$(state "${HOF}")" != absent ]] \
        && [[ ":$(tv shell settings get secure enabled_accessibility_services | tr -d '\r'):" == *":${HOF_SERVICE}:"* ]]; then
        log_info "Home on Fire is installed and on, so Home already opens its target app (picked on the TV)."
        confirm "Run the Home setup again?" || return 0
    fi
    ./make-home.sh
}

# Disables Amazon's ad apps and applies speed tweaks; tune.sh picks a
# checklist or a list itself.
do_tune() { ./tune.sh "$@"; }

# Asks first in the menu; firetv reboot was asked for by name.
do_reboot() {
    connect
    [[ -n "${CMD}" ]] || confirm "Restart the TV at ${TV}?" || return 0
    tv reboot
    _success "The TV is restarting."
}

# Trims app caches, then removes old launcher builds.
do_clean() {
    ./clean.sh
    remove_old_builds
}

# Uninstalls old, debug and devicetest launcher builds (blank tiles beside
# the release) when the TV has any, asking first. Outside a terminal it
# only lists them. Clean and Install both end with it.
remove_old_builds() {
    ./remove-old-launchers.sh --check || return 0
    printf '\n'
    if [[ -t 0 && -t 1 ]]; then
        ./remove-old-launchers.sh
    else
        ./remove-old-launchers.sh --list
        log_info "Run firetv clean in a terminal to remove them."
    fi
}

# Get an app from the Appstore, sideload an APK, or uninstall apps. The
# launcher and Home on Fire are left to Reset, which removes them in
# order; old launcher builds to Clean. With list, add or remove, runs
# apps.sh; outside a terminal, lists the apps.
do_apps() {
    local what
    if (( $# > 0 )); then
        ./apps.sh "$@"
        return
    fi
    if [[ ! -t 0 || ! -t 1 ]]; then
        ./apps.sh list
        return
    fi
    what="$(choose_one "apps" "" "Get an app from the Appstore" "Add an app (APK file)" "Remove apps")"
    [[ -n "${what}" ]] || return 0
    connect
    case "${what}" in
        Get*) store_app ;;
        Add*) add_app ;;
        *) ./apps.sh remove ;;
    esac
}

# A name from appstore.txt, or any app by its package, ASIN or link.
store_app() {
    local other="Another app: package, ASIN or amazon.com link" app
    local -a names=()
    while IFS= read -r app; do names+=("${app}"); done < <(grep -v '^#' appstore.txt | cut -f 1)
    app="$(pick_filtered "Get from the Appstore" "Netflix" "${names[@]}" "${other}")"
    if [[ "${app}" == "${other}" ]]; then
        app="$(ask_text "Package, ASIN or amazon.com link" "tv.pluto.android")" || return 0
    fi
    [[ -n "${app}" ]] || return 0
    ./apps.sh add "${app}"
}

add_app() {
    local apk
    apk="$(ask_text "APK file to install (a path, or drag the file here)" "Downloads/app.apk")" || return 0
    [[ -n "${apk}" ]] || return 0
    # A dragged file arrives with a trailing space, and may arrive quoted.
    apk="${apk%" "}"; apk="${apk#\'}"; apk="${apk%\'}"
    # shellcheck disable=SC2088  # matching a literal ~ the user typed
    [[ "${apk}" != "~/"* ]] || apk="${HOME}/${apk:2}"
    [[ "${apk}" == /* ]] || apk="${START_DIR}/${apk}"
    [[ -f "${apk}" ]] || die "No such file: ${apk}"
    [[ "${apk}" == *.apk ]] || die "Not an .apk file: ${apk}"
    spin "Installing $(basename "${apk}") on ${TV}" adb -s "${TV}" install -r "${apk}"
    _success "Installed $(basename "${apk}")."
}

# The README's reset steps, in its order. A step that fails stops the rest:
# uninstall.sh refuses while Amazon's launcher is disabled.
do_reset() {
    connect
    if [[ "$(state "${HOF}")" == absent ]]; then
        log_info "Home on Fire: not installed"
    elif confirm "Uninstall Home on Fire?"; then
        tv uninstall "${HOF}" | tr -d '\r'
    fi
    if confirm "Put Amazon's launcher back as Home (restore-home.sh)?"; then
        ./restore-home.sh
    fi
    if [[ "$(state "${LAUNCHER_PKG}")" == absent ]]; then
        log_info "Launcher: not installed"
    elif confirm "Uninstall the launcher (uninstall.sh)?"; then
        ./uninstall.sh
    fi
    if confirm "Re-enable every debloated package (restore-debloat.sh)?"; then
        ./restore-debloat.sh
    fi
}

# Connects, walking through what the TV still needs: allowing this
# computer, ADB debugging, Local Network access, or a different IP.
wait_for_tv() {
    local out st next
    while true; do
        out="$(adb_connect)"
        if [[ "${out}" == *"No route to host"* ]]; then
            adb kill-server >/dev/null 2>&1 || true
            out="$(adb_connect)"
        fi
        st="$(tv get-state 2>&1 || true)"
        case "${st}" in
            device)
                _check "Connected to ${TV}"
                return 0
                ;;
            *unauthorized*|*offline*)
                log_info "On the TV: tick Always allow from this computer, then select OK."
                # shellcheck disable=SC2016  # $1 expands in the inner sh
                if spin "Waiting for the TV to allow this computer" sh -c '
                    i=0
                    until [ "$(adb -s "$1" get-state 2>/dev/null)" = device ]; do
                        i=$((i + 1)); [ "${i}" -le 120 ] || exit 1; sleep 1
                    done' _ "${TV}"; then
                    _check "Connected to ${TV}"
                    return 0
                fi
                ;;
            *)
                case "${out}" in
                    *"No route to host"*) log_warn "This terminal app needs Local Network access: System Settings > Privacy & Security > Local Network, then reopen the terminal." ;;
                    *refused*) log_warn "${TV} refused the connection: turn on ADB debugging in Developer options." ;;
                    *) log_warn "No answer from ${TV}: check the IP, and that the TV is on and on this network." ;;
                esac
                ;;
        esac
        # Esc, or end of input, quits.
        next="$(choose_one "Not connected yet" "" "Try again" "Change the IP" "Quit")"
        case "${next}" in
            Try*) ;;
            Change*) ask_host ;;
            *) exit 0 ;;
        esac
    done
}

# One step of the walkthrough. A step that fails or is declined leaves the
# rest to run; each says what it needs.
walk_step() {
    local title="$1"
    shift
    printf '\n'
    _header "${title}"
    run "$@"
}

# What only the remote can do: Developer options, ADB debugging, the IP.
show_tv_steps() {
    _header "Set up the Fire TV"
    _box "On the TV, with the remote:
1. Settings > My Fire TV. If there is no Developer options, open
   About and press OK on the device name 7 times.
2. Developer options: turn on ADB debugging and Apps from Unknown
   Sources.
3. About > Network: note the TV's IP address."
    confirm "Done on the TV?" || { log_info "Run firetv setup again when it is."; exit 0; }
}

# The walkthrough: the TV's own steps, connecting, then install (which
# makes the launcher Home), tune and doctor.
do_setup() {
    [[ "${TV_STEPS_SHOWN:-}" == true ]] || show_tv_steps
    [[ "${FIRETV_HOST_ASKED:-}" == true ]] || confirm "Use the TV at ${TV}?" || ask_host
    wait_for_tv
    walk_step "Step 1 of 3: Install the launcher and make it Home" do_install
    walk_step "Step 2 of 3: Tune" do_tune
    walk_step "Step 3 of 3: Check everything" do_doctor
    printf '\n'
    _success "Set up. Run firetv any time for the menu."
}

# firetv setup shows the TV's own steps before asking for its IP.
if [[ "${CMD}" == setup ]]; then
    show_tv_steps
    TV_STEPS_SHOWN=true
fi
# Asks for the TV's IP unless one is saved or FIRETV_HOST is set.
# shellcheck source=adb.sh
source ./adb.sh

if [[ -n "${CMD}" ]]; then
    "do_${CMD}" "$@"
    exit
fi

menu=()
for step in "${STEPS[@]}"; do
    IFS=';' read -r name _ what <<< "${step}"
    menu+=("$(printf '%-11s %s' "${name}" "${what}")"$'\t'"${name}")
done
menu+=("quit"$'\t'"quit")

offer_update

while true; do
    _header "Launcher: TV ${TV}"
    # Quit, Esc or end of input drops the adb connection.
    # No default, so gum's cursor starts on doctor.
    choice="$(choose_one "Pick a step" "" "${menu[@]}")"
    choice="${choice:-quit}"
    if [[ "${choice}" == quit ]]; then
        adb disconnect "${TV}" >/dev/null 2>&1 || true
        exit 0
    fi
    run "do_${choice}"
    printf '\n'
done
